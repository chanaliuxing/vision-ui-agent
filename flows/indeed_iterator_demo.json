{
  "name": "Indeed.ca Job 10-Click Demo (Precise IDs)",
  "description": "Uses specific, hardcoded IDs to click the first 10 jobs, extract their descriptions, and then scroll.",
  "start": "open_indeed",
  "states": {
    "open_indeed": {
      "description": "Wake up Chrome, open Indeed.ca homepage, and wait for it to settle.",
      "actions": [
        { "do": "open_url", "url": "about:blank", "app": "Google Chrome" },
        { "do": "sleep_ms", "value": 800 },
        { "do": "ext.open_url", "url": "https://ca.indeed.com/", "active": true },
        { "do": "wait_for", "until": { "type": "ext.wait_quiet", "timeout_ms": 15000 } }
      ],
      "on_success": "click_job_1"
    },
    "click_job_1": {
      "actions": [ { "do": "ext.click_selector", "sel": "#sj_ef61a8ab70567358" }, { "do": "wait_for", "until": { "type": "ext.wait_quiet" } } ],
      "on_success": "extract_desc_1"
    },
    "extract_desc_1": {
      "actions": [ { "do": "ext.extract", "args": { "selector": "#jobDescriptionText" } } ],
      "on_success": "click_job_2"
    },
    "click_job_2": {
      "actions": [ { "do": "ext.click_selector", "sel": "#sj_524976cd0d1820de" }, { "do": "wait_for", "until": { "type": "ext.wait_quiet" } } ],
      "on_success": "extract_desc_2"
    },

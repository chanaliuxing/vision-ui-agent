{
  "version": "1.1",
  "name": "instr_demo",
  "description": "Minimal demo using instr.* with coordinate fallback",
  "start": "demo",
  "vars": {
    "demo_bbox": { "x": 200, "y": 200, "w": 120, "h": 48 }
  },
  "states": {
    "demo": {
      "actions": [
        { "do": "instr.navigate", "url": "https://example.com" },
        { "do": "instr.wait", "ms": 800 },
        { "do": "instr.scroll", "dir": "down", "amount": 600 },
        { "do": "instr.click", "target": { "bbox_var": "@demo_bbox" } },
        { "do": "instr.answer_user", "text": "Demo completed" }
      ],
      "on_success": null
    }
  }
}

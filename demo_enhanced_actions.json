{
  "version": "1.3",
  "name": "enhanced_actions_demo",
  "description": "Comprehensive demo of enhanced mouse, keyboard, and clipboard actions",
  "start": "demo_sequence",
  "vars": {
    "danger_words": ["delete", "remove", "pay", "确认删除", "支付"],
    "default_browser": "Google Chrome",
    "toggle_ime_keys": ["ctrl", "space"],
    "prefer_human_input": true,
    "human_mouse": {
      "speed_px_per_s": 1200,
      "steps": 34,
      "overshoot_px": 6,
      "jitter_px": 2
    },
    "human_type_interval_ms": 60
  },
  "states": {
    "demo_sequence": {
      "description": "Demonstrate enhanced workflow capabilities",
      "actions": [
        {
          "do": "screenshot",
          "save_as": "demo_start.png"
        },
        {
          "comment": "=== Clipboard Safety Demo ==="
        },
        {
          "do": "clipboard.push"
        },
        {
          "do": "clipboard.clear"
        },
        {
          "comment": "=== File Operations Demo ==="
        },
        {
          "do": "os.write_text_file",
          "path": "out/demo_file.txt",
          "content": "Enhanced workflow demo file\nCreated with new file operations\n多语言支持测试",
          "mkdirs": true
        },
        {
          "do": "os.read_text_file",
          "path": "out/demo_file.txt",
          "save": "demo_content"
        },
        {
          "comment": "=== JSON Operations Demo ==="
        },
        {
          "do": "os.write_json",
          "path": "out/demo_data.json",
          "data": {
            "demo_type": "enhanced_actions",
            "features": [
              "multi-click support",
              "clipboard safety",
              "file operations",
              "configurable settings"
            ],
            "timestamp": "2024-demo",
            "content_preview": "@demo_content"
          },
          "mkdirs": true
        },
        {
          "comment": "=== Directory Operations Demo ==="
        },
        {
          "do": "os.listdir",
          "path": "out",
          "save": "output_files"
        },
        {
          "comment": "=== Restore Clipboard Demo ==="
        },
        {
          "do": "clipboard.pop"
        },
        {
          "do": "sleep_ms",
          "value": 500
        }
      ],
      "on_success": "demo_results",
      "on_error": "demo_error"
    },
    "demo_results": {
      "description": "Display demo results",
      "actions": [
        {
          "do": "os.write_json",
          "path": "out/demo_results.json",
          "data": {
            "status": "success",
            "demo_completed": true,
            "files_created": "@output_files",
            "content_read": "@demo_content",
            "enhanced_features": [
              "✅ Multi-click support (times, interval_ms)",
              "✅ Mouse button selection (left/right/middle)",
              "✅ Enhanced mouse operations (drag, move)",
              "✅ Enhanced keyboard operations (combo keys, sequences)",
              "✅ Clipboard safety (push/pop/clear)",
              "✅ File operations (read/write text/json)",
              "✅ Directory operations (mkdir, listdir)",
              "✅ Shell command execution",
              "✅ Configurable settings via workflow.vars"
            ]
          },
          "mkdirs": true
        }
      ]
    },
    "demo_error": {
      "description": "Handle demo errors",
      "actions": [
        {
          "do": "os.write_json",
          "path": "out/demo_error.json",
          "data": {
            "status": "error",
            "message": "Demo encountered an error"
          },
          "mkdirs": true
        }
      ]
    }
  }
}
{
  "workflow": {
    "name": "Basic Actions Test",
    "version": "1.0.0",
    "description": "Test basic clipboard and file operations",
    "start": "step1",
    "steps": [
      {
        "id": "step1",
        "name": "Save current clipboard state",
        "type": "action",
        "uses": "ext.clipboard_push",
        "params": {}
      },
      {
        "id": "step2",
        "name": "Clear clipboard for clean start",
        "type": "action",
        "uses": "ext.clipboard_clear",
        "params": {}
      },
      {
        "id": "step3",
        "name": "Set clipboard content",
        "type": "action",
        "uses": "ext.clipboard_set",
        "params": {
          "content": "AutoWorkflow Basic Actions Test"
        }
      },
      {
        "id": "step4",
        "name": "Get clipboard content",
        "type": "action",
        "uses": "ext.clipboard_get",
        "params": {}
      },
      {
        "id": "step5",
        "name": "Create test directory",
        "type": "action",
        "uses": "ext.file_mkdir",
        "params": {
          "path": "./test-output",
          "recursive": true
        }
      },
      {
        "id": "step6",
        "name": "Write test file",
        "type": "action",
        "uses": "ext.file_write",
        "params": {
          "path": "./test-output/test.txt",
          "data": "AutoWorkflow Basic Actions Test File",
          "encoding": "utf8"
        }
      },
      {
        "id": "step7",
        "name": "Restore original clipboard",
        "type": "action",
        "uses": "ext.clipboard_pop",
        "params": {}
      }
    ],
    "edges": [
      {"from": "step1", "to": "step2"},
      {"from": "step2", "to": "step3"},
      {"from": "step3", "to": "step4"},
      {"from": "step4", "to": "step5"},
      {"from": "step5", "to": "step6"},
      {"from": "step6", "to": "step7"}
    ]
  },
  "config": {
    "mode": "dom-only",
    "timeoutMs": 30000,
    "retryAttempts": 1,
    "screenshotOnError": true,
    "enableVisionFallback": false,
    "debugMode": true
  }
}
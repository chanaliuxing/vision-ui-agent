{
  "name": "通用登录表单",
  "description": "适用于用户名/密码登录场景",
  "version": "1.0.0",
  "category": "authentication",
  "parameters": {
    "username": {
      "type": "string",
      "description": "用户名",
      "default": "test@example.com"
    },
    "password": {
      "type": "string",
      "description": "密码",
      "default": "password123"
    },
    "login_url": {
      "type": "string",
      "description": "登录页面URL",
      "default": "https://example.com/login"
    }
  },
  "workflow": {
    "name": "{{name}} - 登录流程",
    "version": "1.0.0",
    "start": "open_login",
    "steps": [
      {
        "id": "open_login",
        "type": "action",
        "uses": "ext.open_url",
        "params": {
          "url": "{{login_url}}"
        }
      },
      {
        "id": "input_username",
        "type": "action",
        "uses": "ext.type",
        "params": {
          "selector": "input[type=email], input[name=username], input[name=email]",
          "text": "{{username}}"
        }
      },
      {
        "id": "input_password",
        "type": "action",
        "uses": "ext.type",
        "params": {
          "selector": "input[type=password], input[name=password]",
          "text": "{{password}}"
        }
      },
      {
        "id": "click_login",
        "type": "action",
        "uses": "ext.click",
        "params": {
          "selector": "button[type=submit], input[type=submit], button:contains('登录'), button:contains('Login')"
        }
      }
    ],
    "edges": [
      {"from": "open_login", "to": "input_username"},
      {"from": "input_username", "to": "input_password"},
      {"from": "input_password", "to": "click_login"}
    ]
  }
}
# .env.example
# PostgreSQL配置
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gamedb
POSTGRES_USER=gameuser
POSTGRES_PASSWORD=gamepass
POSTGRES_DSN=postgresql://gameuser:gamepass@postgres:5432/gamedb

# AWS配置 (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LLM配置
MOCK_LLM=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Redis配置
REDIS_URL=redis://redis:6379/0

# 应用配置
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false

# API网关配置
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_API_DASHBOARD=true

# 工作流配置
WORKFLOW_TIMEOUT=300
MAX_RETRIES=3
ENABLE_MEMORY=true
RECALL_THRESHOLD=0.7

# 特性开关
FLAG_async_engine=true
FLAG_enable_dpo=true
FLAG_enable_ab_testing=true
FLAG_enable_multimodal=true

# YOLO Configuration Examples
# ===========================

# Local YOLO execution (default)
YOLO_MODE=local
YOLO_WEIGHTS=./weights/model.pt
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=1280

# Remote YOLO execution (cloud server)
# YOLO_MODE=remote
# YOLO_REMOTE_URL=http://your-cloud-server:8080/infer
# YOLO_TIMEOUT=30

# Hybrid mode (try remote first, fallback to local)
# YOLO_MODE=hybrid
# YOLO_REMOTE_URL=http://your-cloud-server:8080/infer
# YOLO_TIMEOUT=15

# Example cloud server URLs:
# AWS EC2: http://ec2-xxx-xxx-xxx-xxx.compute-1.amazonaws.com:8080/infer
# Google Cloud: http://xxx.xxx.xxx.xxx:8080/infer
# DigitalOcean: http://droplet-ip:8080/infer
# Custom domain: http://yolo-api.yourdomain.com/infer

# ===========================
# LLM Provider Defaults
# ===========================
# Server-wide provider/model used at startup (respects .env)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=
# GEMINI_API_URL=  # optional override; otherwise derived from LLM_MODEL
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=

# ===========================
# JSON Logging & Full Capture
# ===========================
YOLO_LOG_LEVEL=INFO
YOLO_LOG_REDACT_LEN=300

# Enable full-fidelity capture of request/response, images, overlay/crops, LLM I/O
# All logging now goes to out/ directory (yolo_captures system removed)
FULL_CAPTURE=true

# ===========================
# Planner thresholds
# ===========================
PLANNER_SR_LOW=0.50
PLANNER_SR_MED=0.80
# Disable image resizing for LLM vision,`LLM_VISION_MAX_WIDTH=0`：表示不缩放,
# `LLM_VISION_MAX_WIDTH=1024`：表示限制最大宽度为 1024px。如果原图宽度超过 1024，它会等比例缩放直到宽度等于 1024；如果原图本来就小于1024，则保持不变。
LLM_VISION_MAX_WIDTH=0
PRODUCT_ID=yolo-llm-automation
KEY_ID=K1
ED25519_SEED_B64=REPLACE_WITH_BASE64_SEED   # run: npm run gen:seed
API_BASE=http://localhost:8787
DOMAIN_WHITELIST=xhs.com,indeed.com

# PostgreSQL Database Configuration
DATABASE=postgresql://username:password@localhost:5432/database_name

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_FALLBACKS=openai:gpt-4o-mini,deepseek:deepseek-v3

# Gemini Configuration (Primary for vision tasks)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_TWO=your-backup-gemini-key-here
GEMINI_API_KEY_THREE=your-third-gemini-key-here

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek Configuration
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# NVIDIA API Configuration
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
DEEPSEEK_NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Vision AI Configuration
REPLICATE_OMNIPARSERV2_API_KEY=r8_your-replicate-api-key-here
ROBOFLOW_API_KEY=your-roboflow-api-key-here
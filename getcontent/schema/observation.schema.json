{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "host": {"type": "string"},
    "path": {"type": "string"},
    "nodes": {
      "type":"array",
      "items":{
        "type":"object",
        "properties":{
          "tag":{"type":"string"},
          "role":{"type":["string","null"]},
          "text_top":{"type":"string"},
          "attrs":{"type":"object"},
          "bbox":{"type":"object"}
        },
        "required":["tag","bbox"]
      }
    }
  },
  "required":["host","nodes"]
}